---
import { localeList, type Locale } from "../../i18n";
import { common, content } from "../../data/home";
import Base from "../../layouts/Base.astro";
import "../../styles/home.css";
import { buildCommonRouter } from "../../route";

export const getStaticPaths = () =>
  localeList.map((locale) => ({ params: { locale } }));

const isLocale = (value: string | undefined): value is Locale =>
  typeof value === "string" && localeList.includes(value as Locale);

const currentLocale = Astro.params.locale;
if (!isLocale(currentLocale)) {
  throw new Error(`Unsupported locale: ${currentLocale ?? "missing"}`);
}
const commonRouter = buildCommonRouter();

const page = content[currentLocale];
---

<Base
  locale={currentLocale}
  title={page.meta.title}
  description={page.meta.description}
>
  <main id="main-content" tabindex="-1">
    <section class="hero-section" id="about" aria-labelledby="hero-title">
      <div class="hero-layout">
        <img class="hero-icon" src={commonRouter.route("/icon.png")} alt="" />
        <div class="hero-content">
          <div class="hero-copy">
            <p class="eyebrow">{page.hero.eyebrow}</p>
            <h1 id="hero-title">{page.hero.name}</h1>
            <p class="hero-lead">{page.hero.about}</p>
          </div>
          <dl class="identity-list">
            <div>
              <dt>{page.hero.labels.affiliation}</dt><dd>
                {page.hero.affiliation}
              </dd>
            </div>
            <div>
              <dt>{page.hero.labels.interests}</dt>
              <dd>{page.hero.interests.join(", ")}</dd>
            </div>
            <div>
              <dt>{page.hero.labels.usernames}</dt>
              <dd>{common.usernames.join(", ")}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section
      class="content-section"
      id="history"
      aria-labelledby="history-title"
    >
      <div class="section-heading">
        <h2 id="history-title">{page.history.label}</h2>
      </div>
      <ol class="history-list">
        {
          page.history.entries.map((item) => (
            <li>
              <div class="history-period">{item.period}</div>
              <div>
                <>
                  <h3>{item.title}</h3>
                  <p>{item.detail}</p>
                </>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="content-section"
      id="projects"
      aria-labelledby="projects-title"
    >
      <div class="section-heading">
        <h2 id="projects-title">{page.projects.label}</h2>
      </div>
      <div class="project-list">
        {
          page.projects.entries.map((project) => (
            <article class="project-row">
              <div class="project-body">
                <>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                </>
                <ul class="tag-list">
                  {project.tech.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="content-section research-section"
      id="papers"
      aria-labelledby="papers-title"
    >
      <div class="section-heading">
        <h2 id="papers-title">{page.papers.label}</h2>
      </div>
      <ul class="paper-list">
        {
          page.papers.entries.map((paper) => (
            <li>
              <h3>{paper.title}</h3>
              <p>{paper.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="contact-section"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div>
        <h2 id="contact-title">{page.contacts.label}</h2>
      </div>
      <div class="contact-links">
        <a class="contact-link" href={`mailto:${common.email}`}>
          <span>{page.contacts.entries.email}</span><strong
            >{common.email}</strong
          >
        </a>
        <a
          class="contact-link"
          href={common.github}
          target="_blank"
          rel="noreferrer"
        >
          <span>{page.contacts.entries.github}</span><strong
            >{common.account}</strong
          >
        </a>
      </div>
    </section>
  </main>
</Base>
