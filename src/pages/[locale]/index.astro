---
import { localeList, type Locale } from "../../i18n";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = () =>
  localeList.map((locale) => ({ params: { locale } }));

const isLocale = (value: string | undefined): value is Locale =>
  typeof value === "string" && localeList.includes(value as Locale);

const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) {
  throw new Error(`Unsupported locale: ${localeParam ?? "missing"}`);
}

const locale = localeParam;
const content = {
  en: {
    meta: {
      title: "Junya Yokokura",
      description:
        "Personal homepage of Junya Yokokura, a physics master's student.",
    },
    hero: {
      eyebrow: "Physics / Computation / Open Source",
      title: "Junya Yokokura",
      lead: "Master's student in physics at the University of Tokyo, working at the intersection of physical intuition, mathematical modeling, and scientific computing.",
      labels: {
        shortName: "Short name",
        account: "GitHub account",
        affiliation: "Affiliation",
      },
      affiliation:
        "Tōdō Laboratory · Department of Physics · Graduate School of Science · The University of Tokyo",
    },
    sections: {
      about: "About",
      history: "History",
      projects: "Projects",
      papers: "Research interests",
      contact: "Contact",
    },
    about:
      "I study computational physics and enjoy turning abstract physical questions into clear, reproducible experiments. My interests include statistical mechanics, complex systems, numerical simulation, and the design of scientific software.",
    history: [
      {
        period: "2025 — present",
        title: "Master's student in Physics",
        detail:
          "Tōdō Laboratory, Department of Physics, Graduate School of Science, The University of Tokyo",
      },
      {
        period: "2021 — 2025",
        title: "Undergraduate student in Physics",
        detail:
          "Department of Physics, Faculty of Science, The University of Tokyo",
      },
      {
        period: "2018 — 2021",
        title: "High school student",
        detail: "Tochigi Prefectural Moka High School",
      },
    ],
    interests: [
      "Statistical mechanics and complex systems",
      "Numerical simulation and scientific computing",
      "Quantum information and condensed matter",
      "Machine learning for physical modeling",
    ],
    projects: [
      {
        title: "Tensory",
        description:
          "A Rust framework for tensor operations with generic backends.",
        tech: ["Rust", "Linear algebra"],
      },
      {
        title: "APOBLAST",
        description:
          "Reproducible notebooks for visualizing time evolution and eigenstate properties in model Hamiltonians.",
        tech: ["Python", "Symmetry", "Linear algebra"],
      },
      {
        title: "Open-source contributions",
        description:
          "Tools and documentation for sharing research notes, talks, and project updates.",
        tech: ["Astro", "TypeScript", "GitHub Pages"],
      },
    ],
    contact:
      "I am open to conversations about physics, scientific software, and research collaboration.",
    labels: { email: "Email", github: "GitHub" },
  },
  ja: {
    meta: {
      title: "横倉 淳也",
      description: "物理学を専攻する修士課程学生、横倉淳也の個人ホームページ。",
    },
    hero: {
      eyebrow: "Physics / Computation / Open Source",
      title: "横倉 淳也",
      lead: "東京大学大学院理学系研究科物理学専攻の修士課程で、物理的な直観・数理モデル・科学計算の交差点に関心を持って研究しています。",
      labels: {
        shortName: "呼び名",
        account: "GitHubアカウント",
        affiliation: "所属",
      },
      affiliation: "東京大学大学院理学系研究科 物理学専攻 藤堂研究室",
    },
    sections: {
      about: "概要",
      history: "履歴",
      projects: "プロジェクト",
      papers: "研究関心",
      contact: "コンタクト",
    },
    about:
      "計算物理を中心に、抽象的な物理の問いを明確で再現可能な計算実験へ変換することに取り組んでいます。統計力学、複雑系、数値シミュレーション、科学ソフトウェアの設計に関心があります。",
    history: [
      {
        period: "2025 — 現在",
        title: "物理学専攻 修士課程",
        detail: "東京大学大学院理学系研究科 物理学専攻 藤堂研究室",
      },
      {
        period: "2021 — 2025",
        title: "物理学科 学部課程",
        detail: "東京大学理学部物理学科",
      },
      {
        period: "2018 — 2021",
        title: "高等学校",
        detail: "栃木県立真岡高等学校",
      },
    ],
    interests: [
      "統計力学と複雑系",
      "数値シミュレーションと科学計算",
      "量子情報と物性物理",
      "物理モデリングのための機械学習",
    ],
    projects: [
      {
        title: "Tensory",
        description:
          "汎用バックエンドに対応したテンソル演算のためのRustフレームワーク。",
        tech: ["Rust", "線形代数"],
      },
      {
        title: "APOBLAST",
        description:
          "モデルハミルトニアンの時間発展と固有状態を可視化する再現可能なノートブック。",
        tech: ["Python", "対称性", "線形代数"],
      },
      {
        title: "OSS貢献",
        description:
          "研究ノート、発表、プロジェクトの更新を共有するためのツールとドキュメント。",
        tech: ["Astro", "TypeScript", "GitHub Pages"],
      },
    ],
    contact:
      "物理学、科学ソフトウェア、研究上のコラボレーションについてお気軽にご連絡ください。",
    labels: { email: "メール", github: "GitHub" },
  },
} as const;

const page = content[locale];
const common = {
  shortName: "Jy",
  account: "JyJyJcr",
  email: "junya-yk@g.ecc.u-tokyo.ac.jp",
  github: "https://github.com/JyJyJcr",
};
const FIRST_INDEX = 1;
const NUMBER_WIDTH = 2;
---

<Base
  locale={locale}
  title={page.meta.title}
  description={page.meta.description}
>
  <main>
    <section class="hero-section" id="about" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">{page.hero.eyebrow}</p>
        <h1 id="hero-title">{page.hero.title}</h1>
        <p class="hero-lead">{page.hero.lead}</p>
        <a class="text-link" href={`mailto:${common.email}`}
          >{page.labels.email} <span aria-hidden="true">↗</span></a
        >
      </div>
      <dl class="identity-list">
        <div>
          <dt>{page.hero.labels.shortName}</dt><dd>{common.shortName}</dd>
        </div>
        <div><dt>{page.hero.labels.account}</dt><dd>{common.account}</dd></div>
        <div>
          <dt>{page.hero.labels.affiliation}</dt><dd>
            {page.hero.affiliation}
          </dd>
        </div>
      </dl>
    </section>

    <section class="intro-section" aria-labelledby="about-title">
      <p class="section-index">01</p>
      <div>
        <h2 id="about-title">{page.sections.about}</h2><p>{page.about}</p>
      </div>
    </section>

    <section
      class="content-section"
      id="history"
      aria-labelledby="history-title"
    >
      <div class="section-heading">
        <p class="section-index">02</p><h2 id="history-title">
          {page.sections.history}
        </h2>
      </div>
      <ol class="history-list">
        {
          page.history.map((item, index) => (
            <li>
              <span class="history-number">
                {String(index + FIRST_INDEX).padStart(NUMBER_WIDTH, "0")}
              </span>
              <div class="history-period">{item.period}</div>
              <div>
                <>
                  <h3>{item.title}</h3>
                  <p>{item.detail}</p>
                </>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="content-section"
      id="projects"
      aria-labelledby="projects-title"
    >
      <div class="section-heading">
        <p class="section-index">03</p><h2 id="projects-title">
          {page.sections.projects}
        </h2>
      </div>
      <div class="project-list">
        {
          page.projects.map((project, index) => (
            <article class="project-row">
              <span class="project-number">
                {String(index + FIRST_INDEX).padStart(NUMBER_WIDTH, "0")}
              </span>
              <div class="project-body">
                <>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <ul class="tag-list">
                    {project.tech.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="content-section research-section"
      id="papers"
      aria-labelledby="papers-title"
    >
      <div class="section-heading">
        <p class="section-index">04</p><h2 id="papers-title">
          {page.sections.papers}
        </h2>
      </div>
      <ul class="interest-list">
        {page.interests.map((interest) => <li>{interest}</li>)}
      </ul>
    </section>

    <section
      class="contact-section"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div>
        <p class="section-index">05</p><h2 id="contact-title">
          {page.sections.contact}
        </h2><p>{page.contact}</p>
      </div>
      <div class="contact-links">
        <a class="contact-link" href={`mailto:${common.email}`}
          ><span>{page.labels.email}</span><strong>{common.email}</strong></a
        >
        <a
          class="contact-link"
          href={common.github}
          target="_blank"
          rel="noreferrer"
          ><span>{page.labels.github}</span><strong>{common.account}</strong></a
        >
      </div>
    </section>
  </main>
</Base>

<style>
  main {
    width: min(1160px, 100%);
    margin-inline: auto;
    padding-inline: clamp(1rem, 5vw, 5rem);
  }
  .hero-section {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(250px, 0.7fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    min-height: min(720px, calc(100vh - var(--header-height)));
    padding: clamp(4rem, 10vw, 9rem) 0 clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--line);
  }
  .hero-copy {
    max-width: 740px;
  }
  .eyebrow,
  .section-index {
    margin: 0 0 1.2rem;
    color: var(--accent-strong);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }
  h1 {
    max-width: 900px;
    margin-bottom: 1.5rem;
    font-size: clamp(3rem, 9vw, 8.5rem);
    letter-spacing: -0.04em;
    line-height: 0.92;
  }
  h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(2rem, 4vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  h3 {
    margin-bottom: 0.45rem;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
  }
  .hero-lead {
    max-width: 52ch;
    margin-bottom: 2rem;
    color: var(--text-soft);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: 1.65;
  }
  .text-link {
    color: var(--accent-strong);
    font-weight: 700;
    text-decoration: none;
  }
  .text-link span {
    display: inline-block;
    margin-left: 0.25rem;
    transition: transform 0.2s ease;
  }
  .text-link:hover span,
  .text-link:focus-visible span {
    transform: translate(2px, -2px);
  }
  .identity-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .identity-list div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    color: var(--text-soft);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  dd {
    margin: 0;
    font-weight: 600;
    line-height: 1.4;
  }
  .intro-section,
  .content-section,
  .contact-section {
    padding: clamp(4rem, 8vw, 8rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .intro-section,
  .section-heading {
    display: grid;
    grid-template-columns: minmax(100px, 0.3fr) minmax(0, 0.7fr);
    gap: 2rem;
  }
  .section-heading h2 {
    grid-column: 2;
  }
  .intro-section p:last-child,
  .contact-section p:last-child {
    max-width: 58ch;
    color: var(--text-soft);
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    line-height: 1.7;
  }
  .history-list,
  .project-list,
  .interest-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .history-list li,
  .project-row {
    display: grid;
    grid-template-columns: 5rem minmax(9rem, 0.35fr) minmax(0, 0.65fr);
    gap: 1rem;
    padding: 1.35rem 0;
    border-top: 1px solid var(--line);
  }
  .history-list li:last-child,
  .project-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .history-number,
  .project-number {
    color: var(--accent-strong);
    font-weight: 700;
  }
  .history-period {
    color: var(--text-soft);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .history-list p,
  .project-body p {
    max-width: 54ch;
    margin-bottom: 0;
    color: var(--text-soft);
    line-height: 1.65;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tag-list li {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-soft);
    font-size: 0.78rem;
  }
  .interest-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-left: calc(30% + 2rem);
  }
  .interest-list li {
    padding: 1rem 1rem 1rem 0;
    border-top: 1px solid var(--line);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
  }
  .contact-section {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(250px, 0.3fr);
    gap: clamp(2rem, 8vw, 8rem);
    border-bottom: 0;
  }
  .contact-links {
    display: grid;
    align-content: start;
  }
  .contact-link {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
  }
  .contact-link:last-child {
    border-bottom: 1px solid var(--line);
  }
  .contact-link span {
    color: var(--text-soft);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .contact-link strong {
    overflow-wrap: anywhere;
  }
  .contact-link:hover strong,
  .contact-link:focus-visible strong {
    color: var(--accent-strong);
  }
  @media (max-width: 760px) {
    .hero-section,
    .contact-section,
    .intro-section {
      display: block;
      min-height: 0;
    }
    .hero-section {
      padding-top: 4rem;
    }
    .identity-list {
      margin-top: 4rem;
    }
    .identity-list div {
      grid-template-columns: 7rem 1fr;
    }
    .section-heading {
      display: block;
    }
    .history-list li,
    .project-row {
      grid-template-columns: 2.2rem 1fr;
      gap: 0.6rem;
    }
    .history-period {
      grid-column: 2;
      grid-row: 1;
    }
    .history-list li > div:last-child,
    .project-body {
      grid-column: 2;
    }
    .interest-list {
      grid-template-columns: 1fr;
      margin-left: 0;
    }
    .contact-links {
      margin-top: 2rem;
    }
  }
</style>
