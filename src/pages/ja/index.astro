---
import Normal from "../../layouts/Normal.astro";
import { profile as allProfiles, commonProfile } from "../../data/profile";
// ! import "../../styles/global.css";

const lang = "ja",
  profile = allProfiles[lang],
  interests = [
    "Statistical Mechanics and Complex Systems",
    "Numerical Simulation and Scientific Computing",
    "Quantum Information and Condensed Matter",
    "Machine Learning for Physical Modeling",
  ],
  projects = [
    {
      title: "Tensory",
      description: "Rust Framework for Tensor Operations with generic backends",
      tech: ["Rust", "Linear Algebra"],
    },

    {
      title: "APOBLAST",
      description:
        "Created reproducible notebooks to visualize time evolution and eigenstate properties in model Hamiltonians.",
      tech: ["Python", "Symmetry", "Linear Algebra"],
    },
    {
      title: "OSS貢献",
      description:
        "Designed and deployed a static website for publishing notes, talks, and project updates.",
      tech: ["Astro", "TypeScript", "GitHub Pages"],
    },
  ],
  timeline = [
    {
      period: "2025 - Present",
      title: "Master of Science in Physics",
      detail: "東京大学大学院理学系研究科物理学専攻",
    },
    {
      period: "2021/10 - 2025/03",
      title: "大学生(物理学科)",
      detail: "東大理学部物理学科",
    },
    {
      period: "2021/04 - 2022/09",
      title: "大学生(前期教養)",
      detail: "東大前期教養課程",
    },
    {
      period: "2018/04 - 2021/03",
      title: "高校生",
      detail: "栃木県立真岡高等学校",
    },
  ];
---

<Normal lang={lang} title="メインページ" description="Jyの個人ホームページ。">
  <main>
    <section class="hero" id="about">
      <p class="eyebrow">Physics Graduate Portfolio</p>
      <h1>
        {profile.role.utokyo}
      </h1>
      <p class="subtitle">
        I am <strong>{commonProfile.name.handle}</strong> at <strong
          >{profile.role.utokyo}</strong
        >, currently focused on {profile.focus}. My work combines analytical
        modeling with numerical methods to explore physical phenomena across
        scales.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#projects">View Projects</a>
        <a
          class="button button-secondary"
          href={`mailto:${commonProfile.contact.email}`}>Get in Touch</a
        >
      </div>
    </section>

    <section class="card" id="research">
      <h2>Research Interests</h2>
      <ul class="interest-list">
        {interests.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="grid-section">
      <article class="card">
        <h2>Education</h2>
        <ul class="timeline">
          {
            timeline.map((item) => (
              <li>
                <span class="period">{item.period}</span>
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="card">
        <h2>Current Focus</h2>
        <p>
          I am currently interested in connecting rigorous physical intuition
          with robust computational experiments. I value reproducibility, open
          science, and clear communication of technical ideas.
        </p>
        <p>
          Outside academic work, I write technical notes, experiment with
          visualization, and contribute to coding projects that support research
          workflows.
        </p>
      </article>
    </section>

    <section class="card" id="projects">
      <h2>Selected Projects</h2>
      <div class="project-grid">
        {
          projects.map((project) => (
            <article class="project-item">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <ul class="tag-list">
                {project.tech.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="card" id="contact">
      <h2>Contact</h2>
      <p>
        If you are interested in collaboration, discussion, or research
        opportunities, please feel free to reach out.
      </p>
      <ul class="contact-list">
        <li>
          Email:
          <a href={`mailto:${commonProfile.contact.email}`}
            >{commonProfile.contact.email}</a
          >
        </li>
        <li>
          GitHub:
          <a href={commonProfile.contact.github}
            >{commonProfile.contact.github}</a
          >
        </li>
      </ul>
    </section>
  </main>
</Normal>
