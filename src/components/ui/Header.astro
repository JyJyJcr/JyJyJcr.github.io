---
import type { Locale } from "../../i18n";
import Navigation from "./Navigation.astro";
import LocaleSelecter from "./LocaleSelecter.astro";
import type { HeaderTranslation } from "./Header.types";

interface Props {
  selectedLocale: Locale;
  localeList: Locale[];
  rootPrefixer: (path: string) => string;
  localeSwitcher: (locale: Locale, path: string) => string;
  translation: HeaderTranslation;
}
const {
  selectedLocale,
  localeList,
  rootPrefixer,
  localeSwitcher,
  translation,
} = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <Navigation
      translation={translation.navigation}
      rootPrefixer={rootPrefixer}
    />
    <LocaleSelecter
      selectedLocale={selectedLocale}
      localeList={localeList}
      localeSwitcher={localeSwitcher}
      translation={translation.localeSelector}
    />
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 10;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--line);
    background: rgba(244, 246, 248, 0.9);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    width: 100%;
    min-height: var(--header-height);
    padding-inline: clamp(1rem, 4vw, 4rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media (max-width: 760px) {
    .header-inner {
      width: 100%;
    }
  }
</style>
