---
import Navigation from "./Navigation.astro";
import LocaleSelecter from "./LocaleSelecter.astro";
import type { HeaderLocalization } from "./Header.types";
import type { Router, ReverseRouter } from "../../route";
import type { LocaleEntryLocalization } from "./LocaleSelecter.types";

interface Props {
  router: Router & ReverseRouter;
  loc: HeaderLocalization;
  localeEntries: {
    router: Router;
    loc: LocaleEntryLocalization;
  }[];
  selectedLocaleEntryIdx: number;
}
const { router, loc, localeEntries, selectedLocaleEntryIdx } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <Navigation router={router} loc={loc.navigation} />
    <LocaleSelecter
      xRouter={router}
      loc={loc.localeSelector}
      entries={localeEntries}
      selectedEntryIdx={selectedLocaleEntryIdx}
    />
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 10;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .header-inner {
    width: min(960px, calc(100% - 2rem));
    margin-inline: auto;
    height: var(--header-height);
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    gap: 2rem;
  }
</style>
