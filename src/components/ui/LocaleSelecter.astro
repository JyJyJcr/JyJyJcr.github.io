---
import type {
  LocaleSelecterLocalization,
  LocaleEntryLocalization,
} from "./LocaleSelecter.types";
import type { Router, ReverseRouter } from "../../route";

interface Props {
  loc: LocaleSelecterLocalization;
  xRouter: ReverseRouter;
  entries: {
    router: Router;
    loc: LocaleEntryLocalization;
  }[];
  selectedEntryIdx: number;
}
const { loc, xRouter, entries, selectedEntryIdx } = Astro.props;
const selectedEntry =
  entries[selectedEntryIdx] ??
  (() => {
    throw new Error("No selected entry");
  })();
---

<details
  class="locale-selector"
  data-locale-selector
  aria-label={loc.explanation}
  lang={loc.code}
>
  <summary lang={selectedEntry.loc.code}>{selectedEntry.loc.nativeName}</summary
  >
  <ul>
    {
      entries.map(({ router, loc: entryLoc }, index) => (
        <li>
          <a
            href={router.route(xRouter.xRoute(Astro.url.pathname))}
            aria-current={index === selectedEntryIdx && "page"}
            class:list={{ "list-selected": index === selectedEntryIdx }}
            lang={entryLoc.code}
          >
            {entryLoc.nativeName}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script src="./LocaleSelecter.client.ts"></script>

<style>
  .locale-selector {
    position: relative;
    margin-left: auto;
    min-width: 7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    list-style: none;
    min-height: 2.75rem;
    padding: 0.45rem 0.8rem;
    white-space: nowrap;
    color: var(--text-soft);
    font-size: 0.9rem;
    font-weight: 700;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  ul {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 8rem;
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0.6rem;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(20, 36, 51, 0.14);
  }

  :global(.locale-selector[open]) {
    visibility: hidden;
  }

  :global(.locale-selector[open]) summary {
    visibility: hidden;
  }

  :global(.locale-selector[open]) ul {
    visibility: visible;
  }

  a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.35rem 0.5rem;
    color: var(--text-soft);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--accent-strong);
    background: #edf7fa;
  }

  a.list-selected {
    font-weight: 700;
  }
</style>
