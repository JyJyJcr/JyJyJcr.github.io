---
import type { Language } from "../i18n/types";
import { ui as allUi } from "../data/ui";
import { langRoute } from "../route";

interface Props {
  lang: Language;
}
const { lang } = Astro.props,
  ui  = allUi[lang];
---

<header class="site-header">
  <a href={langRoute(lang, "/")}>{ui.profile.name}</a>
    {
      (
        <nav aria-label="Main navigation">
          <a href={langRoute(lang, "/#about")}>About</a>
          <a href={langRoute(lang, "/#research")}>Research</a>
          <a href={langRoute(lang, "/#projects")}>Projects</a>
          <a href={langRoute(lang, "/#contact")}>Contact</a>
        </nav>
        <div class="language">{}</div>
      )
    }
  </header>

