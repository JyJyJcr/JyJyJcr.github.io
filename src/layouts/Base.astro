---
import { localeList, type Locale } from "../i18n";
import Head from "../components/Head.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import { baseLocalizations } from "../i18n/ui";
import { buildNormalLocaleRouter } from "../route";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale: currentLocale, title, description } = Astro.props;
const currentRouter = buildNormalLocaleRouter(currentLocale);
const currentLocalization = baseLocalizations[currentLocale];

const entries = localeList.map((locale) => ({
  router: buildNormalLocaleRouter(locale),
  loc: baseLocalizations[locale].entry,
}));

const idx = (() => {
  const maybeIndex = localeList.findIndex((locale) => locale === currentLocale);
  const notFoundIndex = -1;
  if (maybeIndex === notFoundIndex) {
    throw new Error(`Unsupported locale: ${currentLocale}`);
  }
  return maybeIndex;
})();
---

<html lang={currentLocale}>
  <Head
    title={currentLocalization.wrapTitle(title)}
    description={description}
  />
  <body>
    <a class="skip-link" href="#main-content" lang={currentLocalization.code}
      >{currentLocalization.skipToContent}</a
    >
    <Header
      router={currentRouter}
      loc={currentLocalization.header}
      localeEntries={entries}
      selectedLocaleEntryIdx={idx}
    />
    <div class="page-content">
      <slot />
    </div>
    <Footer loc={currentLocalization.footer} />
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f6f8;
    --text: #142433;
    --text-soft: #365266;
    --line: #b7c8d8;
    --accent: #0e7490;
    --accent-strong: #155e75;
    --header-height: 4.5rem;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    padding: 0;
    font-family: "Space Grotesk", "Avenir Next", "Segoe UI", sans-serif;
    color: var(--text);
    background: var(--bg);
  }

  body {
    line-height: 1.5;
  }

  :lang(en) body {
    font-family: "Space Grotesk", "Avenir Next", "Segoe UI", sans-serif;
    hyphens: auto;
  }

  :lang(ja) body {
    font-family: "Hiragino Sans", "Yu Gothic", "Noto Sans JP", sans-serif;
    line-break: strict;
    overflow-wrap: anywhere;
  }

  h1 {
    hyphens: none;
    overflow-wrap: normal;
    word-break: keep-all;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 20;
    padding: 0.65rem 0.9rem;
    color: #fff;
    background: var(--accent-strong);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  .page-content {
    position: relative;
    z-index: 1;
    padding-top: var(--header-height);
  }

  main,
  footer {
    width: 100%;
    margin-inline: auto;
    padding-inline: 4rem;
  }

  main {
    display: grid;
    gap: 1.2rem;
    padding-bottom: 0;
  }

  footer {
    width: 100%;
    position: relative;
    z-index: 1;
    margin: 0;
    border-top: 1px solid var(--line);
    color: var(--text-soft);
    padding: 1.25rem 4rem 1.5rem;
    background: var(--bg);
    font-size: 0.85rem;
  }

  @media (max-width: 760px) {
    main,
    footer {
      padding-inline: 1rem;
    }

    footer {
      padding-block: 1.25rem 1.5rem;
    }
  }

  footer p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
