---
import type { Language } from "../i18n/types";
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import { ui as allUi } from "../data/ui";

interface Props {
  lang: Language;
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props,
  ui = allUi[lang];
---

<Base
  lang={lang}
  title={`${title} | ${ui.profile.name}`}
  description={description}
>
  <div aria-hidden="true" class="ambient"></div>
  <Header lang={lang} />
  <slot />
  <footer>
    <p>
      &copy; {new Date().getFullYear()} at {ui.profile.name}. All rights
      reserved.
    </p>
  </footer>
</Base>
